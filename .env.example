# RainTrace environment variables
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
# Never commit a real `.env.local` (it is gitignored).

# --- Supabase (required) ---------------------------------------------------
# Project URL and publishable ("client") key, from your Supabase project's
# Connect dialog or API settings. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase service role (optional, server-only) -------------------------
# Privileged key that bypasses Row Level Security. Used only by server-side
# admin tasks (see lib/supabase/admin.ts). NEVER prefix this with NEXT_PUBLIC_
# and never expose it to the browser or commit a real value. Leave empty unless
# privileged server-side access is actually needed.
SUPABASE_SERVICE_ROLE_KEY=
